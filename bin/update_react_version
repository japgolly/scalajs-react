#!/bin/bash
cd "$(dirname "$0")/.." || exit 1

[ $# -ne 1 ] && echo "Usage: $0 <version>" && exit 1
ver="$1"

perl -pi -e 's/\b19\.\d+\.\d+\b/'"$ver"'/' \
    js-sandbox/index.html \
    library/ghpages/html/*.html

perl -pi -e 's/("react.*)\b19\.\d+\.\d+\b/${1}'"$ver"'/' \
    react-umd/package.json

cd react-umd
echo "Rebuilding React UMD..."
rm -rf dist package-lock.json
npm install
npm run build
cd ..

git diff -U0
